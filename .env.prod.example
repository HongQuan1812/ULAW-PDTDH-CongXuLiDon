# Biến môi trường BẢN THẬT. Chép thành .env.prod trên máy chủ: cp .env.prod.example .env.prod
# Ý nghĩa từng biến: README, mục Biến môi trường. Mật khẩu đặt mới, chỉ dùng chữ và số

# ----- PostgreSQL -----
POSTGRES_ADMIN_USER=ulaw_admin
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=ulaw_cong_xu_li_don
APP_DB_PASSWORD=
APP_DB_NAME=cong_xu_li_don

# ----- nginx (trống: 80, 443, ./docker/nginx/certs) -----
HTTP_PORT=
HTTPS_PORT=
TLS_CERT_DIR=

# ----- Backend -----
APP_ENV=
ENABLE_DEMO_APIS=false
ALWAYS_REAL_APIS=
WEB_BASE_URL_PRODUCTION=https://<tên miền thật của cổng>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=lhquan@hcmulaw.edu.vn
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key cho Google Picker (chọn thư mục Drive ở trang Sao lưu) · trống: chưa chọn được thư mục Drive
GOOGLE_PICKER_API_KEY=
FIRST_ADMIN_EMAIL=
# Họ tên Admin đầu tiên: có thì đăng nhập là vào thẳng · trống: lần đầu đăng nhập tự nhập
FIRST_ADMIN_NAME=

# ----- Database trường (SQL Server, chỉ đọc), cho student-directory bản thật · trống: chưa kết nối -----
SCHOOL_DB_HOST=
SCHOOL_DB_PORT=1433
SCHOOL_DB_USER=
SCHOOL_DB_PASSWORD=
