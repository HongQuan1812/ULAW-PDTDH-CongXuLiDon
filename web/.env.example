# Biến môi trường của giao diện. Chép thành web/.env rồi sửa theo máy của mình (web/.env không đưa lên git).
# Biến có tiền tố VITE_ được đưa vào mã chạy trong trình duyệt (ai cũng đọc được): không đặt bí mật ở đây.

# Request /api đi tới đâu (không liên quan VITE_APP_ENV):
#   true: backend giả (MSW) chạy ngay trong trình duyệt trả lời, trừ các nhóm trong VITE_REAL_BACKEND_GROUPS
#   false: mọi request tới backend thật (api/)
VITE_USE_MOCK_BACKEND=false
# Khi VITE_USE_MOCK_BACKEND=true: các nhóm vẫn tới backend thật, cách nhau bằng dấu phẩy · bỏ trống: mọi nhóm dùng backend giả
#   Tên nhóm: accounts, auth, email, exports, files, form-notes, form-types, form, forms, health, profile (sai tên thì giao diện báo lỗi)
VITE_REAL_BACKEND_GROUPS=health,auth,profile,accounts,form-types,files,forms,form,exports,form-notes,email
# Chức năng thử nghiệm của giao diện (không liên quan backend thật hay giả):
#   dev: hiện các phần JUST FOR DEMO (khung đăng nhập thử, đổi vai trò trong menu) · bỏ trống: không hiện
VITE_APP_ENV=dev
# Tỉ lệ backend giả trả lỗi 500 ngẫu nhiên (0 → 1), để thử giao diện khi máy chủ lỗi · 0: không bao giờ lỗi · nhóm đi backend thật không bị ảnh hưởng
VITE_MOCK_BACKEND_FAILURE_RATE=0.15

# Cổng chạy web khi dev; đổi thì sửa cả WEB_BASE_URL_DEV trong api/.env
WEB_PORT=5173
# Địa chỉ backend; Vite chuyển các request /api sang đây (cổng phải khớp API_PORT trong api/.env)
API_PROXY_TARGET=http://localhost:3000
