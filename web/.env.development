# true: dùng API giả (MSW) ngay trong trình duyệt · false: gọi API thật
VITE_USE_MOCKS=true
# dev: hiện các phần JUST FOR DEMO (chọn vai trò khi đăng nhập, đổi vai trò trong menu) · bỏ trống: không hiện
VITE_APP_ENV=dev
# Tỉ lệ API giả trả lỗi 500 ngẫu nhiên (0 → 1), để thử giao diện khi máy chủ lỗi · 0: không bao giờ lỗi
VITE_MOCK_FAILURE_RATE=0.15
