# Biến môi trường DEV. Chép thành .env.dev: cp .env.dev.example .env.dev
# Ý nghĩa từng biến: README, mục Biến môi trường

# ----- PostgreSQL -----
POSTGRES_ADMIN_USER=ulaw_admin
POSTGRES_ADMIN_PASSWORD=ulaw_admin_dev_password
POSTGRES_PORT=5432
APP_DB_USER=ulaw_cong_xu_li_don
APP_DB_PASSWORD=ulaw_cong_xu_li_don_dev_password
APP_DB_NAME=cong_xu_li_don
# Phải khớp APP_DB_* và POSTGRES_PORT ở trên
DATABASE_URL=postgresql://ulaw_cong_xu_li_don:ulaw_cong_xu_li_don_dev_password@localhost:5432/cong_xu_li_don?schema=public

# ----- Backend -----
APP_ENV=dev
ENABLE_DEMO_APIS=true
# API giả muốn chạy bản thật, cách nhau dấu phẩy (danh sách: api/src/config/demo-apis.ts):
# dev-login,dev-student-directory,dev-email,dev-google-drive-connect
ALWAYS_REAL_APIS=
API_PORT=3000
UPLOAD_DIR=uploads
BACKUP_DIR=backups
WEB_BASE_URL_DEV=https://localhost:5173
# Trống: không gửi thư, chỉ in ra console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=lhquan@hcmulaw.edu.vn
SMTP_PASSWORD=
DEV_EMAIL_REDIRECT_TO=
# Trống: chưa bật đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key cho Google Picker (chọn thư mục Drive ở trang Sao lưu) · trống: chưa chọn được thư mục Drive
GOOGLE_PICKER_API_KEY=

# ----- Database trường (SQL Server, chỉ đọc), cho student-directory bản thật · trống: chưa kết nối -----
SCHOOL_DB_HOST=
SCHOOL_DB_PORT=1433
SCHOOL_DB_USER=
SCHOOL_DB_PASSWORD=

# ----- Giao diện -----
VITE_USE_MOCK_BACKEND=false
VITE_REAL_BACKEND_GROUPS=health,auth,profile,accounts,form-types,files,forms,form,exports,form-notes,email,data-sources,backups,holidays
VITE_APP_ENV=dev
VITE_MOCK_BACKEND_FAILURE_RATE=0.15
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:3000
