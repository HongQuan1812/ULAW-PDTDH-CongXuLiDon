# Biến môi trường khi phát triển. Chép thành .env (không commit .env) rồi sửa nếu cần.

# ---------- PostgreSQL (docker-compose.yml) ----------
# Superuser chung của cả instance: chỉ để quản trị (tạo user, database cho từng dự án). Ứng dụng không dùng tài khoản này
POSTGRES_ADMIN_USER=ulaw_admin
POSTGRES_ADMIN_PASSWORD=ulaw_admin_dev_password
POSTGRES_PORT=5432

# User và database riêng của dự án này: không phải superuser, chỉ làm chủ database của mình
APP_DB_USER=ulaw_cong_xu_li_don
APP_DB_PASSWORD=ulaw_cong_xu_li_don_dev_password
APP_DB_NAME=cong_xu_li_don

# ---------- Backend (api/) ----------
# Prisma kết nối database bằng user của dự án; phải khớp các biến APP_DB_* và POSTGRES_PORT ở trên
DATABASE_URL=postgresql://ulaw_cong_xu_li_don:ulaw_cong_xu_li_don_dev_password@localhost:5432/cong_xu_li_don?schema=public
