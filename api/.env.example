# Biến môi trường của backend. Chép thành api/.env (không commit .env) rồi sửa nếu cần.

# Prisma kết nối database bằng user của dự án; phải khớp APP_DB_* và POSTGRES_PORT trong .env ở thư mục gốc
DATABASE_URL=postgresql://ulaw_cong_xu_li_don:ulaw_cong_xu_li_don_dev_password@localhost:5432/cong_xu_li_don?schema=public

# Môi trường: dev (Swagger ở /api/docs, thư in ra console, dùng WEB_BASE_URL_DEV) · bỏ trống: bản thật
APP_ENV=dev

# Bản giả của API backend (không liên quan APP_ENV). Bản giả tên dev-<tên>, danh sách trong DEMO_APIS (api/src/config/demo-apis.ts):
#   - true: API nào có bản giả thì dùng bản giả, vd POST /auth/login đăng nhập thử theo vai trò (bản giả dev-login, không qua Google)
#     Trừ các API trong ALWAYS_REAL_APIS: luôn dùng bản thật
#   - false / bỏ trống: dùng bản thật, vd đăng nhập Google (cần GOOGLE_CLIENT_ID / SECRET bên dưới)
#   Bản thật chưa phát triển (vd dev-student-directory) thì request gọi tới báo lỗi 501, backend vẫn chạy
ENABLE_DEMO_APIS=true
# Khi ENABLE_DEMO_APIS=true: các API vẫn dùng bản thật, cách nhau bằng dấu phẩy · bỏ trống: không có
#   vd ALWAYS_REAL_APIS=dev-login để thử đăng nhập Google thật mà các API khác vẫn giả · tên sai thì backend báo lỗi khi khởi động
ALWAYS_REAL_APIS=

# Cổng backend nghe; Vite (web/) chuyển /api sang cổng này
API_PORT=3000

# Thư mục lưu tệp tải lên trên ổ đĩa máy chủ (đã được .gitignore bỏ qua)
UPLOAD_DIR=uploads

# Máy chủ gửi thư (SMTP). SMTP_HOST quyết định có gửi thư thật hay không, APP_ENV không ảnh hưởng:
#   - Có điền (vd Gmail: smtp.gmail.com): gửi thư thật, kể cả khi APP_ENV=dev
#   - Bỏ trống: không gửi thư nào; riêng APP_ENV=dev thì thư in ra console của backend để xem
SMTP_HOST=
SMTP_PORT=465
# Tài khoản SMTP, cũng là địa chỉ gửi thư (hiện ở trang Cấu hình email, không sửa được trên trang)
SMTP_USER=daotao@hcmulaw.edu.vn
SMTP_PASSWORD=

# Địa chỉ của cổng (giao diện), dùng cho đường dẫn tới đơn trong thư: APP_ENV=dev dùng bản DEV, còn lại dùng bản PRODUCTION
WEB_BASE_URL_DEV=https://localhost:5173
WEB_BASE_URL_PRODUCTION=https://<tên miền thật của cổng>

# Chỉ dùng khi APP_ENV=dev, để không gửi nhầm thư tự động (báo đơn đổi trạng thái) tới email của người dùng mẫu:
#   - Có điền: mọi thư tự động gửi về địa chỉ này thay vì người nộp đơn
#   - Bỏ trống: thư tự động chỉ in ra console của backend, không gửi đi
# Thư thử ở trang Cấu hình email vẫn gửi tới địa chỉ nhập trên trang
DEV_EMAIL_REDIRECT_TO=

# Đăng nhập Google: OAuth client loại "Web application" tạo ở Google Cloud Console (cách tạo: README.md, mục Đăng nhập Google)
#   - Authorized redirect URIs khai báo: <WEB_BASE_URL_DEV hoặc PRODUCTION>/api/auth/google/callback, vd https://localhost:5173/api/auth/google/callback
#   - Bỏ trống: chưa bật đăng nhập Google; ENABLE_DEMO_APIS=true vẫn đăng nhập thử theo vai trò được
# Tên miền email được vào cổng không đặt ở đây mà ở SCHOOL_EMAIL_DOMAINS (shared/src/validators/auth.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
