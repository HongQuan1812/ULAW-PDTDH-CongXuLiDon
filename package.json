{
  "name": "cong-xu-li-don",
  "private": true,
  "scripts": {
    "dev:up": "docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build",
    "dev:down": "docker compose -f docker-compose.dev.yml --env-file .env.dev down",
    "dev:wipe": "docker compose -f docker-compose.dev.yml --env-file .env.dev down -v",
    "dev:reset": "docker compose -f docker-compose.dev.yml --env-file .env.dev restart api web",
    "dev:logs": "docker compose -f docker-compose.dev.yml --env-file .env.dev logs -f",
    "dev:test": "docker compose -f docker-compose.dev.yml --env-file .env.dev exec api pnpm test",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "prod:wipe": "docker compose -f docker-compose.prod.yml --env-file .env.prod down -v",
    "prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.prod logs -f"
  }
}
